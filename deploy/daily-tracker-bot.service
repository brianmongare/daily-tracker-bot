[Unit]
Description=Brian's Daily Tracker Telegram Bot
After=network.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/daily-tracker-bot
EnvironmentFile=/home/botuser/daily-tracker-bot/.env
ExecStart=/home/botuser/daily-tracker-bot/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
